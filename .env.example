# Comma-separated list of hostnames the HTTP transport (src/mcp/http.ts)
# will accept in the Host header, e.g. commerce-ops-mcp.onrender.com
# Optional locally; set this on the hosting provider once the deployed
# hostname is known. See docs/decisions.md for why this matters.
MCP_ALLOWED_HOSTS=

# Port the HTTP transport listens on. Render sets this automatically —
# only needed for local testing of src/mcp/http.ts.
PORT=3000
